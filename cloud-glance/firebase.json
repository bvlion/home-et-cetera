{
  "functions": [
    {
      "source": "functions",
      "codebase": "cloud-glance",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".git",
        "tests",
        "*.log",
        ".secret.local",
        ".env*"
      ]
    }
  ],
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "function": {
          "functionId": "cloudGlance",
          "region": "asia-east1"
        }
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "no-referrer"
          }
        ]
      }
    ]
  },
  "emulators": {
    "hosting": {
      "port": 15000
    },
    "functions": {
      "port": 15001
    },
    "auth": {
      "port": 19099
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}

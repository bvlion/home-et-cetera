{
  "name": "cloud-glance",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.2 <23"
  },
  "scripts": {
    "build": "node build.js",
    "test": "node --test tests/frontend.test.js tests/configuration.test.js && npm --prefix functions test",
    "check": "npm test && npm run build",
    "emulators": "firebase emulators:start --project demo-cloud-glance --only hosting,functions,auth",
    "test:emulators": "node tests/run-emulators.js"
  },
  "dependencies": {
    "firebase": "12.19.0",
    "marked": "18.0.14",
    "dompurify": "3.4.16"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "jsdom": "30.1.1",
    "firebase-tools": "15.32.1"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.5"
  }
}

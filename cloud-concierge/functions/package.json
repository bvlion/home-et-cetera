{
  "name": "functions",
  "description": "Cloud Functions for Firebase",
  "scripts": {
    "lint": "eslint .",
    "serve": "FIREBASE_DATABASE_URL=https://demo-cloud-concierge-default-rtdb.firebaseio.com SPEAK_TIME_TEMPLATE=\"Example {time} {timestamp}\" firebase emulators:start --project demo-cloud-concierge --only functions,database",
    "test:emulators": "cd .. && FIREBASE_DATABASE_URL=https://demo-cloud-concierge-default-rtdb.firebaseio.com SPEAK_TIME_TEMPLATE=\"Example {time} {timestamp}\" firebase emulators:exec --project demo-cloud-concierge --only functions,database 'node scripts/verify-emulators.mjs'"
  },
  "engines": {
    "node": "24"
  },
  "main": "index.js",
  "private": true,
  "dependencies": {
    "axios": "^1.7.4",
    "firebase-admin": "^12.3.1",
    "firebase-functions": "^7.0.5"
  },
  "devDependencies": {
    "eslint": "^9.9.0",
    "eslint-plugin-promise": "^7.1.0",
    "firebase-functions-test": "^3.3.0",
    "firebase-tools": "^15.5.1"
  }
}
